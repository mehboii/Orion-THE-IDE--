{
  "name": "agent-terminal-ide",
  "version": "14.0.0",
  "description": "Desktop Terminal IDE for managing multiple CLI coding agents (Claude, Codex, Aider) simultaneously in a grid layout",
  "homepage": "https://github.com/mehboii/Orion-THE-IDE-",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "npm run test:updater && npm run test:extensions && npm run test:smoke && npm run test:workdir && npm run test:external-cwd && npm run test:custom-models && npm run test:code-editor && npm run test:editor-fixes && npm run test:editor-window && npm run test:run-debug && npm run test:git",
    "rebuild": "npx @electron/rebuild -v 31.2.0",
    "postinstall": "npx @electron/rebuild -v 31.2.0",
    "dist": "npm run dist:linux",
    "dist:linux": "electron-builder --linux AppImage deb rpm tar.gz --x64",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "test:updater": "node test/update-service.js && node test/update-ui.js && node test/update-app.js",
    "test:updater:live": "node test/update-live.js",
    "test:smoke": "node test/smoke.js",
    "test:workdir": "node test/verify-workdir-consistency.js",
    "test:external-cwd": "node test/verify-external-cwd.js",
    "test:custom-models": "node test/verify-custom-models.js",
    "test:code-editor": "node test/verify_code_editor.js",
    "test:editor-fixes": "node test/verify_editor_fixes.js",
    "test:editor-window": "node test/verify_editor_window.js",
    "test:run-debug": "node test/verify_run_debug_and_cwd.js",
    "test:git": "node test/git-service.js",
    "test:explorer-stability": "node test/verify-explorer-stability.js",
    "test:extensions": "node test/marketplace-http.js && node test/extension-service.js && node test/extension-editor.js && node test/editor-extensions.js && node test/marketplace-ui.js"
  },
  "keywords": [
    "electron",
    "terminal",
    "grid",
    "tmux",
    "claude-code",
    "codex",
    "aider",
    "pty",
    "xterm"
  ],
  "author": "Antigravity <support@antigravity.ide>",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.2.0",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.0.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "linkedom": "^0.18.13",
    "playwright": "^1.51.1"
  },
  "build": {
    "appId": "com.antigravity.agent-terminal-ide",
    "productName": "ORION IDE",
    "npmRebuild": false,
    "afterPack": "build/verify-package.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "config/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Antigravity <support@antigravity.ide>",
      "icon": "build/icon.png",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORION IDE 14"
    }
  },
  "allowScripts": {
    "node-pty": true,
    "@electron/rebuild": true
  }
}
